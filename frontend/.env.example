# Modelo do .env.local do frontend (copie e ajuste). Nunca coloque valores reais aqui.

# Endereço da API FastAPI. Usado SOMENTE no servidor Next.js: o navegador nunca a acessa.
API_URL=http://127.0.0.1:8000

# Mesma chave do INTERNAL_API_KEY da API (vazio = desligada, só para rodar localmente).
# Sem o prefixo NEXT_PUBLIC_: nunca vai para o navegador.
INTERNAL_API_KEY=

# Link do repositório mostrado na demonstração
NEXT_PUBLIC_REPO_URL=https://github.com/omatmarinho/mindcare-ai-portfolio
