# Modelo do arquivo .env (copie para ".env"). NUNCA coloque valores reais aqui:
# este arquivo vai para o GitHub.

# development ou production. Em production a API se recusa a iniciar com
# configuração insegura e o /docs fica desligado.
APP_ENV=development
LOG_LEVEL=INFO

# Banco. Vazio em development = SQLite local (backend/mindcare.db).
# PostgreSQL: postgresql://USUARIO:SENHA@HOST:5432/postgres
DATABASE_URL=

# Chave dos tokens JWT (64+ caracteres):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Chave que criptografa transcrições e resumos (Fernet):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NOTES_ENCRYPTION_KEY=

# IA: "demo" (simulada, sem servidor de IA) ou "local" (Whisper + Ollama;
# exige requirements-ai.txt e o Ollama rodando)
AI_BACKEND=demo
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2:7b
WHISPER_MODEL=small

# Demonstração: botão "Experimentar" cria uma conta temporária com dados fictícios
DEMO_MODE=true
DEMO_TTL_HOURS=24

# Chave interna entre frontend e API (obrigatória se a API ficar exposta na internet).
# Vazio = desligada (desenvolvimento local). Mesmo valor no frontend.
INTERNAL_API_KEY=

# Origens autorizadas a chamar a API pelo navegador e endereço do frontend
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# E-mails: console = só imprime no terminal; resend = envia (exige as duas abaixo)
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=
